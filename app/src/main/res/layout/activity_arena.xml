<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollArena"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_arcade"
    android:clipToPadding="false"
    tools:context=".ArenaActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_arena_tela"
            android:textColor="@color/texto_principal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoApelidoArena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/caramelo"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/subtitulo_arena"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/card_arcade"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/borda_arcade"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/textoPlacar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/texto_principal"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_voce"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                        <ImageView
                            android:id="@+id/imagemEscolhaJogador"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:contentDescription="@string/desc_escolha_vazia"
                            android:visibility="invisible" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_dispositivo"
                            android:textColor="@color/texto_secundario"
                            android:textSize="13sp" />

                        <ImageView
                            android:id="@+id/imagemEscolhaDispositivo"
                            android:layout_width="84dp"
                            android:layout_height="84dp"
                            android:contentDescription="@string/desc_escolha_vazia"
                            android:visibility="invisible" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/textoMensagemRodada"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/escolha_jogada"
                    android:textColor="@color/texto_principal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textoResultadoFinal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <ImageButton
                android:id="@+id/btnPedra"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_botao_jogada"
                android:contentDescription="@string/desc_btn_pedra"
                android:padding="14dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_pedra" />
            <ImageButton
                android:id="@+id/btnPapel"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_botao_jogada"
                android:contentDescription="@string/desc_btn_papel"
                android:padding="14dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_papel" />
            <ImageButton
                android:id="@+id/btnTesoura"
                android:layout_width="0dp"
                android:layout_height="88dp"
                android:layout_marginHorizontal="4dp"
                android:layout_weight="1"
                android:background="@drawable/bg_botao_jogada"
                android:contentDescription="@string/desc_btn_tesoura"
                android:padding="14dp"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/ic_tesoura" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/dica_empate"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnNovaPartidaArena"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_nova_partida"
            android:textAllCaps="false"
            android:textColor="@color/botao_primario"
            app:cornerRadius="14dp"
            app:strokeColor="@color/botao_primario" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnVoltarArena"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_voltar"
                android:textAllCaps="false"
                android:textColor="@color/botao_primario"
                app:cornerRadius="14dp"
                app:strokeColor="@color/botao_primario" />

            <Button
                android:id="@+id/btnEncerrarArena"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/caramelo"
                android:text="@string/btn_encerrar_sessao"
                android:textAllCaps="false"
                android:textColor="@color/texto_botao"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
