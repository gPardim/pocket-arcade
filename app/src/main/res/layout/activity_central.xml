<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollCentral"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_arcade"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".CentralActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textoSaudacao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_principal"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoIntroCentral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/intro_central"
            android:textColor="@color/texto_secundario"
            android:textSize="15sp" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_arcade"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/borda_arcade"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imagemScanner"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/desc_icone_scanner"
                    app:srcCompat="@drawable/ic_painel_scanner" />

                <TextView
                    android:id="@+id/tituloScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/titulo_painel_scanner"
                    android:textColor="@color/texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/descricaoScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/descricao_painel_scanner"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnAbrirScanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/botao_primario"
                    android:text="@string/btn_abrir"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_botao"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelArena"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_arcade"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/borda_arcade"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imagemArena"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/desc_icone_arena"
                    app:srcCompat="@drawable/ic_painel_arena" />

                <TextView
                    android:id="@+id/tituloArena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/titulo_painel_arena"
                    android:textColor="@color/texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/descricaoArena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/descricao_painel_arena"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnAbrirArena"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/botao_primario"
                    android:text="@string/btn_abrir"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_botao"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_arcade"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/borda_arcade"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imagemCodigo"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/desc_icone_codigo"
                    app:srcCompat="@drawable/ic_painel_codigo" />

                <TextView
                    android:id="@+id/tituloCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/titulo_painel_codigo"
                    android:textColor="@color/texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/descricaoCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/descricao_painel_codigo"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnAbrirCodigo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/botao_primario"
                    android:text="@string/btn_abrir"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_botao"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelRandomizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/card_arcade"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/borda_arcade"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="18dp">

                <ImageView
                    android:id="@+id/imagemRandomizador"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="@string/desc_icone_randomizador"
                    app:srcCompat="@drawable/ic_painel_randomizador" />

                <TextView
                    android:id="@+id/tituloRandomizador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="@string/titulo_painel_randomizador"
                    android:textColor="@color/texto_principal"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/descricaoRandomizador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/descricao_painel_randomizador"
                    android:textColor="@color/texto_secundario"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnAbrirRandomizador"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/botao_primario"
                    android:text="@string/btn_abrir"
                    android:textAllCaps="false"
                    android:textColor="@color/texto_botao"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tituloDicas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/titulo_dicas"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoDicas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/texto_dicas"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textoCreditos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/texto_creditos"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnVoltarApresentacao"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/btn_voltar_apresentacao"
            android:textAllCaps="false"
            android:textColor="@color/botao_primario"
            app:cornerRadius="14dp"
            app:strokeColor="@color/botao_primario" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
