<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollScanner"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_arcade"
    android:clipToPadding="false"
    tools:context=".ScannerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/textoTituloScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/titulo_scanner_tela"
            android:textColor="@color/texto_principal"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textoApelidoScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/caramelo"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/editMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/caramelo"
            android:gravity="top|start"
            android:hint="@string/hint_mensagem"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="3"
            android:textColor="@color/texto_principal"
            android:textColorHint="@color/texto_secundario" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnAnalisar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/botao_primario"
                android:text="@string/btn_analisar"
                android:textAllCaps="false"
                android:textColor="@color/texto_botao"
                app:cornerRadius="14dp" />

            <Button
                android:id="@+id/btnLimpar"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/btn_limpar"
                android:textAllCaps="false"
                android:textColor="@color/botao_primario"
                app:cornerRadius="14dp"
                app:strokeColor="@color/botao_primario" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/painelResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/botao_primario"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_medida"
                        android:textColor="@color/pastel_amarelo"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_resultado"
                        android:textColor="@color/pastel_amarelo"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medida_caracteres"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/valorCaracteres"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medida_palavras"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/valorPalavras"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medida_vogais"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/valorVogais"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medida_invertido"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/valorInvertido"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/medida_palindromo"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/valorPalindromo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/texto_botao"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnVoltarScanner"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/btn_voltar"
                android:textAllCaps="false"
                android:textColor="@color/botao_primario"
                app:cornerRadius="14dp"
                app:strokeColor="@color/botao_primario" />

            <Button
                android:id="@+id/btnEncerrarScanner"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/caramelo"
                android:text="@string/btn_encerrar_sessao"
                android:textAllCaps="false"
                android:textColor="@color/texto_botao"
                app:cornerRadius="14dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
